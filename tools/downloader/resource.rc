#include <windows.h>

IDI_ICON1 ICON "QueryReaderSetup.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,1,0,0
 PRODUCTVERSION  1,1,0,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0
 FILEOS          VOS_NT_WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "QueryReader"
            VALUE "FileDescription", "QueryReader Installer"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "QueryReaderSetup"
            VALUE "OriginalFilename", "QueryReaderSetup.exe"
            VALUE "ProductName", "QueryReader"
            VALUE "ProductVersion", "1.1.0"
            VALUE "LegalCopyright", "QueryReader Project"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
